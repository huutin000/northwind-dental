# Template with fake values. Copy it to a local, git-ignored env file and fill in real values there.
# All of these are server-only: do not add a NEXT_PUBLIC_ prefix.
AI_MODE=mock
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b
SESSION_SECRET=change-me-to-a-long-random-string
# Optional key-value store (Upstash Redis REST), server-only. Without them the app
# keeps rate-limit counters and leads in per-instance memory. Use ONE of the pairs.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
# Alternative names (set by the Vercel integration); the UPSTASH pair wins if both exist:
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-token-here
